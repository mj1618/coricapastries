# Contact form delivery (Resend). Without the key the form shows a "please call us" message.
# The key is the SupplyWise Resend account's (see ../supplywise/.env.prod); the sender must be
# on a domain verified there, which is why the default from-address is @supplywise.com.au.
RESEND_API_KEY=
CONTACT_TO_EMAIL=enquiries@corica.com.au
CONTACT_FROM_EMAIL="Corica Pastries Website <noreply@supplywise.com.au>"

# Cloudflare Turnstile bot check on the contact form (Cloudflare dashboard → Turnstile → Add
# widget, hostname = the site's domain). Both unset: the check is skipped with a warning.
# Cloudflare's test keys, which always pass, are handy locally:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
