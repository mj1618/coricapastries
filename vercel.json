{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "(www\\.)?coricapastries\\.com\\.au" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
